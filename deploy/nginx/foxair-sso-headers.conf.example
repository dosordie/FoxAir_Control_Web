# Add alongside the existing proxy_set_header directives for FoxWeb.
# Keep authelia-location.conf, authelia-auth.conf, satisfy any, allow/deny,
# proxy_pass, TLS and WebSocket directives unchanged.
auth_request_set $foxair_auth_status $upstream_status;
auth_request_set $foxair_sso_user $upstream_http_remote_user;

# A dedicated name avoids duplicate Remote-User directives in existing includes.
# These values overwrite identically named client-supplied headers.
proxy_set_header X-FoxAir-SSO-User $foxair_sso_user;
proxy_set_header X-FoxAir-SSO-Authenticated $foxair_sso_verified;
include /etc/nginx/private/foxair-sso-secret.conf;

# The PRIVATE root-owned include above must contain exactly:
# proxy_set_header X-FoxAir-SSO-Secret "REPLACE_WITH_THE_SHARED_SECRET";
# Never put a real secret in this repository or a browser.
