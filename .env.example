# Copy to .env on the Docker host (do not commit your .env).
# Until the first GHCR release exists, build locally and use FOXAIR_IMAGE=foxair-web:local.
FOXAIR_IMAGE=ghcr.io/dosordie/foxair-control-web:0.1.0

# Default: listen only on the Docker host. For a reverse proxy on a different
# machine, bind to a private host IP and restrict it by firewall to the proxy.
FOXAIR_BIND_IP=127.0.0.1
FOXAIR_HTTP_PORT=8081

# Explicit TCP peer IP of your HTTPS proxy; leave empty without a trusted proxy.
FOXAIR_TRUSTED_PROXY_IPS=
