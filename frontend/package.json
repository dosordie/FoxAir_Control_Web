{
  "name": "foxair-control-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src/composables src/components",
    "format:check": "prettier --check src/composables src/components"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.12"
  }
}
